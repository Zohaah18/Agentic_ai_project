# Copy to .env  (NEVER commit .env). No paid keys are needed anywhere in this project.
FINAGENT_MODE=auto            # auto | agentic | pipeline

# --- Open-source LLM via Ollama (https://ollama.com), runs on your own machine ---
OLLAMA_MODEL=qwen2.5:7b       # needs ~8 GB RAM. Weak laptop? use qwen2.5:3b or llama3.2:3b (less reliable)
OLLAMA_HOST=                  # blank = http://localhost:11434
AGENT_MAX_STEPS=6

# --- Data providers (first success wins, others are fallbacks) ---
FINANCE_PROVIDERS=yfinance    # e.g. mcp,yfinance after configuring MCP_* below
MCP_COMMAND=
MCP_ARGS=
MCP_TOOL_NAME=
MCP_TICKER_ARG=symbol

# --- Resilience / safety ---
PROVIDER_TIMEOUT_S=15
PROVIDER_RETRIES=2
BREAKER_THRESHOLD=3
BREAKER_RESET_S=60
MAX_QUERIES_PER_MINUTE=10
LOG_QUERIES=false
KILL_SWITCH=0
